-- Núcleo Central: acuerdos, objetivos y espacio privado
create table if not exists public.portal_objectives (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  description text,
  horizon text not null default 'corto' check (horizon in ('corto','medio','largo')),
  status text not null default 'activo' check (status in ('activo','pausado','logrado')),
  progress integer not null default 0 check (progress between 0 and 100),
  due_date date,
  world_id uuid references public.portal_worlds(id) on delete set null,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_agreements (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  decision text,
  status text not null default 'propuesta' check (status in ('propuesta','acordado','en_vigor','descartado')),
  decided_at date not null default current_date,
  world_id uuid references public.portal_worlds(id) on delete set null,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create trigger portal_objectives_touch before update on public.portal_objectives
  for each row execute function public.portal_touch_updated_at();
create trigger portal_agreements_touch before update on public.portal_agreements
  for each row execute function public.portal_touch_updated_at();

alter table public.portal_objectives enable row level security;
alter table public.portal_agreements enable row level security;

create policy portal_objectives_admin_read on public.portal_objectives for select to authenticated
  using (public.portal_is_admin());
create policy portal_objectives_admin_insert on public.portal_objectives for insert to authenticated
  with check (public.portal_is_admin());
create policy portal_objectives_admin_update on public.portal_objectives for update to authenticated
  using (public.portal_is_admin()) with check (public.portal_is_admin());
create policy portal_objectives_admin_delete on public.portal_objectives for delete to authenticated
  using (public.portal_is_admin());

create policy portal_agreements_admin_read on public.portal_agreements for select to authenticated
  using (public.portal_is_admin());
create policy portal_agreements_admin_insert on public.portal_agreements for insert to authenticated
  with check (public.portal_is_admin());
create policy portal_agreements_admin_update on public.portal_agreements for update to authenticated
  using (public.portal_is_admin()) with check (public.portal_is_admin());
create policy portal_agreements_admin_delete on public.portal_agreements for delete to authenticated
  using (public.portal_is_admin());

alter table public.portal_conversations
  add column if not exists scope text not null default 'matrix' check (scope in ('matrix','core'));

alter policy portal_conversations_read on public.portal_conversations
  using (scope = 'matrix' or public.portal_is_admin());
alter policy portal_conversations_insert on public.portal_conversations
  with check (public.portal_can_edit() and (scope <> 'core' or public.portal_is_admin()));
alter policy portal_conversations_update on public.portal_conversations
  using (public.portal_can_edit() and (scope <> 'core' or public.portal_is_admin()))
  with check (public.portal_can_edit() and (scope <> 'core' or public.portal_is_admin()));
alter policy portal_conversations_delete on public.portal_conversations
  using (public.portal_can_edit() and (scope <> 'core' or public.portal_is_admin()));

alter policy portal_messages_read on public.portal_messages
  using (exists (
    select 1 from public.portal_conversations c
    where c.id = portal_messages.conversation_id
      and (c.scope = 'matrix' or public.portal_is_admin())
  ));
alter policy portal_messages_insert on public.portal_messages
  with check (
    public.portal_can_edit()
    and exists (
      select 1 from public.portal_conversations c
      where c.id = portal_messages.conversation_id
        and (c.scope = 'matrix' or public.portal_is_admin())
    )
  );
alter policy portal_messages_delete on public.portal_messages
  using (
    public.portal_can_edit()
    and exists (
      select 1 from public.portal_conversations c
      where c.id = portal_messages.conversation_id
        and (c.scope = 'matrix' or public.portal_is_admin())
    )
  );

