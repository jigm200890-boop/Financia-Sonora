-- Etapa 1: mundos, separación y expediente maestro
create table if not exists public.portal_worlds (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  kind text not null default 'empresa' check (kind in ('personal','empresa','proyecto','tecnologia','biblioteca')),
  description text,
  visibility text not null default 'shared' check (visibility in ('shared','owner')),
  owner_id uuid references auth.users(id) on delete set null,
  accent text not null default 'blue',
  sort_order integer not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create trigger portal_worlds_touch before update on public.portal_worlds
  for each row execute function public.portal_touch_updated_at();

alter table public.portal_worlds enable row level security;

create policy portal_worlds_read on public.portal_worlds for select to authenticated
  using (visibility = 'shared' or owner_id = auth.uid() or public.portal_is_admin());
create policy portal_worlds_insert on public.portal_worlds for insert to authenticated
  with check (public.portal_can_edit());
create policy portal_worlds_update on public.portal_worlds for update to authenticated
  using (public.portal_can_edit()) with check (public.portal_can_edit());
create policy portal_worlds_delete on public.portal_worlds for delete to authenticated
  using (public.portal_is_admin());

alter table public.portal_knowledge_folders
  add column if not exists world_id uuid references public.portal_worlds(id) on delete cascade;
alter table public.portal_knowledge_items
  add column if not exists world_id uuid references public.portal_worlds(id) on delete cascade;

create index if not exists portal_folders_world_idx on public.portal_knowledge_folders(world_id);
create index if not exists portal_items_world_idx on public.portal_knowledge_items(world_id);

create or replace function public.portal_world_visible(p_world_id uuid)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from public.portal_worlds w
    where w.id = p_world_id
      and (w.visibility = 'shared' or w.owner_id = auth.uid() or public.portal_is_admin())
  );
$$;

alter policy portal_folders_read on public.portal_knowledge_folders
  using (world_id is null or public.portal_world_visible(world_id));
alter policy portal_folders_insert on public.portal_knowledge_folders
  with check (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)));
alter policy portal_folders_update on public.portal_knowledge_folders
  using (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)))
  with check (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)));
alter policy portal_folders_delete on public.portal_knowledge_folders
  using (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)));

alter policy portal_items_read on public.portal_knowledge_items
  using (world_id is null or public.portal_world_visible(world_id));
alter policy portal_items_insert on public.portal_knowledge_items
  with check (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)));
alter policy portal_items_update on public.portal_knowledge_items
  using (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)))
  with check (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)));
alter policy portal_items_delete on public.portal_knowledge_items
  using (public.portal_can_edit() and (world_id is null or public.portal_world_visible(world_id)));

