-- Ficha de identidad y contexto operativo del Núcleo Central
create table if not exists public.portal_core_identity (
  id uuid primary key default gen_random_uuid(),
  section text not null unique check (section in ('mision','principios','criterios','alcance','limites','prioridades','forma_trabajo')),
  title text not null,
  content text,
  status text not null default 'pendiente' check (status in ('pendiente','definido')),
  position integer not null default 0,
  updated_at timestamptz not null default now(),
  updated_by uuid references auth.users(id) on delete set null
);

alter table public.portal_core_identity enable row level security;
create policy portal_core_identity_admin_read on public.portal_core_identity for select to authenticated
  using (public.portal_is_admin());
create policy portal_core_identity_admin_insert on public.portal_core_identity for insert to authenticated
  with check (public.portal_is_admin());
create policy portal_core_identity_admin_update on public.portal_core_identity for update to authenticated
  using (public.portal_is_admin()) with check (public.portal_is_admin());

