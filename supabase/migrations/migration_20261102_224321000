-- Respaldo y versionado de información
create table if not exists public.portal_backup_steps (
  id uuid primary key default gen_random_uuid(),
  phase text not null,
  title text not null,
  detail text,
  status text not null default 'pendiente' check (status in ('pendiente','en_curso','hecho','bloqueado')),
  sort_order integer not null default 0,
  updated_at timestamptz not null default now(),
  updated_by uuid references auth.users(id) on delete set null
);

alter table public.portal_backup_steps enable row level security;
create policy portal_backup_admin_read on public.portal_backup_steps for select to authenticated
  using (public.portal_is_admin());
create policy portal_backup_admin_update on public.portal_backup_steps for update to authenticated
  using (public.portal_is_admin()) with check (public.portal_is_admin());
create policy portal_backup_admin_insert on public.portal_backup_steps for insert to authenticated
  with check (public.portal_is_admin());

create table if not exists public.portal_knowledge_versions (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references public.portal_knowledge_items(id) on delete cascade,
  name text not null,
  content text,
  tags text[] not null default '{}',
  saved_at timestamptz not null default now(),
  saved_by uuid references auth.users(id) on delete set null
);

create index if not exists portal_versions_item_idx on public.portal_knowledge_versions(item_id);

alter table public.portal_knowledge_versions enable row level security;
create policy portal_versions_read on public.portal_knowledge_versions for select to authenticated
  using (exists (
    select 1 from public.portal_knowledge_items i
    where i.id = portal_knowledge_versions.item_id
      and (i.world_id is null or public.portal_world_visible(i.world_id))
  ));

create or replace function public.portal_version_item()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  if new.name is distinct from old.name
     or new.content is distinct from old.content
     or new.tags is distinct from old.tags then
    insert into public.portal_knowledge_versions (item_id, name, content, tags, saved_by)
    values (old.id, old.name, old.content, old.tags, auth.uid());
  end if;
  return new;
end;
$$;

create trigger portal_items_version before update on public.portal_knowledge_items
  for each row execute function public.portal_version_item();

