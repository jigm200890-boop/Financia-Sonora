-- Portal de Acceso Único — Financia Sonora (proyecto nuevo, sin tablas previas)
create extension if not exists pgcrypto;

create table if not exists public.portal_profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  email text not null,
  full_name text,
  role text not null default 'editor' check (role in ('admin','editor','viewer')),
  created_at timestamptz not null default now()
);

create table if not exists public.portal_apps (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  platform text not null default 'Otra',
  category text not null default 'Aplicaciones',
  owner_account text,
  summary text,
  app_url text,
  builder_url text,
  status text not null default 'unverified' check (status in ('active','unverified','pending','offline','unpublished')),
  features_ready text[] not null default '{}',
  features_pending text[] not null default '{}',
  notes text,
  last_checked_at timestamptz,
  last_check_result text,
  sort_order integer not null default 0,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_agents (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  provider text not null default 'Enter AI',
  model text not null,
  protocol text not null default 'openai_chat_completions',
  description text,
  responsibilities text,
  tools text[] not null default '{}',
  uses_knowledge boolean not null default true,
  status text not null default 'active' check (status in ('active','paused')),
  accent text not null default 'blue',
  sort_order integer not null default 0,
  created_at timestamptz not null default now()
);

create table if not exists public.portal_conversations (
  id uuid primary key default gen_random_uuid(),
  title text not null default 'Nueva conversación',
  mode text not null default 'matrix' check (mode in ('matrix','single')),
  session_id text not null default gen_random_uuid()::text,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_messages (
  id uuid primary key default gen_random_uuid(),
  conversation_id uuid not null references public.portal_conversations(id) on delete cascade,
  agent_id uuid references public.portal_agents(id) on delete set null,
  role text not null check (role in ('user','assistant')),
  content text not null default '',
  created_at timestamptz not null default now()
);

create table if not exists public.portal_knowledge_folders (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  parent_id uuid references public.portal_knowledge_folders(id) on delete cascade,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_knowledge_items (
  id uuid primary key default gen_random_uuid(),
  folder_id uuid references public.portal_knowledge_folders(id) on delete cascade,
  name text not null,
  kind text not null default 'document' check (kind in ('document','file')),
  content text,
  storage_path text,
  mime_type text,
  size_bytes bigint,
  tags text[] not null default '{}',
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_tasks (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  description text,
  assignee text,
  status text not null default 'pendiente' check (status in ('pendiente','en_curso','bloqueada','hecha')),
  priority text not null default 'media' check (priority in ('baja','media','alta')),
  due_date date,
  app_id uuid references public.portal_apps(id) on delete set null,
  agent_id uuid references public.portal_agents(id) on delete set null,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_integrations (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  kind text not null default 'API' check (kind in ('API','Enlace autorizado','Informativa')),
  status text not null default 'pending' check (status in ('active','pending','unavailable')),
  owner text,
  url text,
  notes text,
  last_checked_at timestamptz,
  last_check_result text,
  created_at timestamptz not null default now()
);

create table if not exists public.portal_workflows (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  objective text,
  owner text,
  status text not null default 'borrador' check (status in ('borrador','activo','pausado')),
  steps jsonb not null default '[]'::jsonb,
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.portal_check_logs (
  id uuid primary key default gen_random_uuid(),
  target_type text not null check (target_type in ('app','integration')),
  target_id uuid not null,
  target_name text,
  result text not null,
  detail text,
  checked_by uuid references auth.users(id) on delete set null,
  checked_at timestamptz not null default now()
);

create index if not exists portal_messages_conversation_idx on public.portal_messages(conversation_id);
create index if not exists portal_knowledge_items_folder_idx on public.portal_knowledge_items(folder_id);
create index if not exists portal_knowledge_folders_parent_idx on public.portal_knowledge_folders(parent_id);

create or replace function public.portal_touch_updated_at()
returns trigger language plpgsql as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create or replace function public.portal_is_admin()
returns boolean language sql stable security definer set search_path = public as $$
  select coalesce((select role = 'admin' from public.portal_profiles where id = auth.uid()), false);
$$;

create or replace function public.portal_can_edit()
returns boolean language sql stable security definer set search_path = public as $$
  select coalesce((select role in ('admin','editor') from public.portal_profiles where id = auth.uid()), false);
$$;

create or replace function public.portal_handle_new_user()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  assigned_role text;
begin
  select case when count(*) = 0 then 'admin' else 'editor' end into assigned_role from public.portal_profiles;
  insert into public.portal_profiles (id, email, full_name, role)
  values (
    new.id,
    coalesce(new.email, ''),
    coalesce(new.raw_user_meta_data->>'full_name', split_part(coalesce(new.email,''), '@', 1)),
    assigned_role
  )
  on conflict (id) do nothing;
  return new;
end;
$$;

create trigger portal_on_auth_user_created
  after insert on auth.users
  for each row execute function public.portal_handle_new_user();

create trigger portal_apps_touch before update on public.portal_apps for each row execute function public.portal_touch_updated_at();
create trigger portal_conversations_touch before update on public.portal_conversations for each row execute function public.portal_touch_updated_at();
create trigger portal_knowledge_folders_touch before update on public.portal_knowledge_folders for each row execute function public.portal_touch_updated_at();
create trigger portal_knowledge_items_touch before update on public.portal_knowledge_items for each row execute function public.portal_touch_updated_at();
create trigger portal_tasks_touch before update on public.portal_tasks for each row execute function public.portal_touch_updated_at();
create trigger portal_workflows_touch before update on public.portal_workflows for each row execute function public.portal_touch_updated_at();

